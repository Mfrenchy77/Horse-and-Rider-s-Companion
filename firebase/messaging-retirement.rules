// Staged Firestore security rules for final legacy messaging shutdown.
// Deploy only after backfill_requests and retire_legacy_messaging complete.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /Conversations/{conversationId} {
      allow read, write: if false;

      match /Messages/{messageId} {
        allow read, write: if false;
      }
    }
  }
}
