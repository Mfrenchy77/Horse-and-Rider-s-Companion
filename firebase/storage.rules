rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /Riders_Photo/{riderId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /Horses_Photo/{horseId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /covers/{userEmail}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == userEmail;
    }

    match /resources/pdfs/{resourceId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
