rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isVerifiedDictionaryAdmin() {
      return request.auth != null
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('admin', false) == true;
    }

    function isValidDictionaryImage() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in [
          'image/png',
          'image/jpeg',
          'image/webp'
        ];
    }

    match /Riders_Photo/{riderId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /Horses_Photo/{horseId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /covers/{userEmail}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == userEmail;
    }

    match /resources/pdfs/{resourceId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Private community submission uploads: verified contributors may create
    // images in their own submission folder and read/delete their own pending files;
    // verified Dictionary administrators may inspect or delete them during review.
    match /dictionary_submissions/{uid}/{submissionId}/{fileName} {
      allow read, delete: if (
        request.auth != null
        && request.auth.token.get('email_verified', false) == true
        && request.auth.uid == uid
      ) || isVerifiedDictionaryAdmin();
      allow create: if request.auth != null
        && request.auth.token.get('email_verified', false) == true
        && request.auth.uid == uid
        && isValidDictionaryImage();
      allow update: if false;
    }

    // Private draft uploads: only verified Dictionary administrators may read or write.
    match /dictionary_drafts/{entryId}/{fileName} {
      allow read: if isVerifiedDictionaryAdmin();
      allow create, update: if isVerifiedDictionaryAdmin()
        && isValidDictionaryImage();
      allow delete: if isVerifiedDictionaryAdmin();
    }

    // Published Dictionary images: publicly readable, written only by Cloud Functions on publish.
    match /dictionary_public/{entryId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }
  }
}
