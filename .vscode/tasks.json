{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build web for validation",
			"type": "shell",
			"command": "${config:dart.flutterSdkPath}/bin/flutter",
			"args": [
				"build",
				"web",
				"--release",
				"--no-pub"
			],
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Check app and backend",
			"type": "shell",
			"command": "python3",
			"args": [
				"tool/check.py"
			],
			"group": "test",
			"problemMatcher": [],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"label": "Check Flutter only",
			"type": "shell",
			"command": "python3",
			"args": [
				"tool/check.py",
				"--skip-functions"
			],
			"group": "test",
			"problemMatcher": [],
			"options": {
				"cwd": "${workspaceFolder}"
			}
		}
	]
}
